# =================================================================
# 衍序 · AlgoFlow 统一环境变量配置示例
# 复制并重命名为 .env 生效: cp .env.example .env
# =================================================================

# 项目全局版本
ALGOFLOW_VERSION=latest

# 时区配置
TZ=Asia/Shanghai

# -------------------------------------------------------------
# 基础设施服务配置 (docker-compose-env.yml)
# -------------------------------------------------------------
# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=algorithm

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Nacos 配置与注册中心
NACOS_HOST=algorithm-nacos
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/

# Grafana
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -------------------------------------------------------------
# 外部访问端口映射 (宿主机映射端口)
# -------------------------------------------------------------
FRONTEND_PORT=3000
GATEWAY_PORT_EXTERNAL=8080
USER_SERVICE_PORT_EXTERNAL=8081
POST_SERVICE_PORT_EXTERNAL=8082
NOTIFICATION_SERVICE_PORT_EXTERNAL=8083
SEARCH_SERVICE_PORT_EXTERNAL=8084
FILE_SERVICE_PORT_EXTERNAL=8085
LOG_SERVICE_PORT_EXTERNAL=8086
MAIL_SERVICE_PORT_EXTERNAL=8087
AI_SERVICE_PORT_EXTERNAL=8088

# -------------------------------------------------------------
# 前端客户端环境变量
# -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
